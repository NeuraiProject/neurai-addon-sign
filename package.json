{
  "name": "neurai-wallet-extension",
  "version": "0.15.0",
  "description": "Neurai Sign (XNA) Chrome Extension - Manage wallet, sign messages, check balance",
  "private": true,
  "scripts": {
    "postinstall": "node sync-libs.js",
    "dev": "vite --config vite.config.test.js",
    "build": "node verify-libs.js && node build-all.js",
    "build:ext": "node verify-libs.js && node build-ext.js",
    "build:test": "vite build --config vite.config.test.js",
    "sync-libs": "node sync-libs.js",
    "pack": "node verify-libs.js && node build-ext.js && node pack.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test --no-warnings \"test/**/*.test.mjs\"",
    "verify:no-rpc-sign": "if grep -rn 'signrawtransaction' src/; then echo 'ERROR: forbidden RPC signing path present'; exit 1; fi",
    "verify:libs": "node verify-libs.js"
  },
  "dependencies": {
    "@neuraiproject/neurai-assets": "^1.8.3",
    "@neuraiproject/neurai-connect": "^0.0.2",
    "@neuraiproject/neurai-connect-core": "^0.0.2",
    "@neuraiproject/neurai-create-transaction": "^0.9.2",
    "@neuraiproject/neurai-key": "^5.0.3",
    "@neuraiproject/neurai-message": "^0.11.0",
    "@neuraiproject/neurai-reader": "^0.2.0",
    "@neuraiproject/neurai-scripts": "^0.9.2",
    "@neuraiproject/neurai-sign-esp32": "^0.7.1",
    "@neuraiproject/neurai-sign-transaction": "^3.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.38",
    "esbuild": "0.25.12",
    "typescript": "^6.0.2",
    "vite": "^6.4.2"
  }
}
